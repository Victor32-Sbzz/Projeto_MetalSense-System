# ==============================================================================
# METALSENSE SYSTEM - CONFIGURAÇÃO DE AMBIENTE (12-FACTOR)
# Copie este arquivo para .env e ajuste os valores conforme o ambiente
# ==============================================================================

METALSENSE_ENV=production
METALSENSE_LOG_LEVEL=INFO
METALSENSE_LOG_JSON=true

# --- BANCO DE DADOS (PostgreSQL + TimescaleDB) ---
POSTGRES_DB=metalsense
POSTGRES_USER=metalsense_admin
POSTGRES_PASSWORD=altere_esta_senha_para_producao_2026!
DATABASE_URL=postgresql+psycopg://metalsense_admin:altere_esta_senha_para_producao_2026!@timescaledb:5432/metalsense

# --- CACHE & RATE LIMITING (Redis) ---
REDIS_PASSWORD=altere_esta_senha_redis_2026!
RATELIMIT_STORAGE_URI=redis://:altere_esta_senha_redis_2026!@redis:6379/0

# --- CHAVES DE SEGURANÇA (RBAC) ---
METALSENSE_API_KEYS_ADMIN=admin-secret-token-segura-2026
METALSENSE_API_KEYS_DISPOSITIVO=esp32-sensor-linha-01,esp32-sensor-linha-02
METALSENSE_API_KEYS_LEITURA=scada-supervisor-token-2026

# --- SERVIDOR WSGI GUNICORN ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_BIND=0.0.0.0:5000
